rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isUser(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isFamilyParent(familyId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/families/$(familyId)).data.parentUid == request.auth.uid;
    }

    function isLinkedChild(familyId, childId) {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/families/$(familyId)/children/$(childId)).data.get('deviceUid', null) == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    match /linkCodes/{code} {
      allow create: if isAuthenticated() && isFamilyParent(request.resource.data.familyId);
      allow get: if isAuthenticated() && resource.data.expiresAt > request.time;
      allow list: if false;
      allow update: if false;
      allow delete: if isAuthenticated() && (
        isFamilyParent(resource.data.familyId) ||
        getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/children/$(resource.data.childId)).data.get('deviceUid', null) == request.auth.uid
      );
    }

    match /families/{familyId} {
      allow create: if isAuthenticated() && request.resource.data.parentUid == request.auth.uid;
      allow read, update, delete: if isAuthenticated() && resource.data.parentUid == request.auth.uid;

      match /children/{childId} {
        allow read, write: if isFamilyParent(familyId);
        allow read: if isAuthenticated() && resource.data.get('deviceUid', null) == request.auth.uid;

        allow update: if isAuthenticated() && (
          // linked device: heartbeat fields only
          (resource.data.get('deviceUid', null) == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastSeen', 'deviceName', 'monitoringDisabled', 'monitoringDisabledAt']))
          ||
          // first-time linking: needs a valid, unexpired link code
          (resource.data.get('deviceUid', null) == null &&
            request.resource.data.deviceUid == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceUid', 'deviceName', 'linkedAt', 'lastSeen']) &&
            get(/databases/$(database)/documents/linkCodes/$(resource.data.linkCode)).data.expiresAt > request.time)
        );

        match /usageDays/{dateKey} {
          allow read: if isFamilyParent(familyId);
          allow write: if isLinkedChild(familyId, childId);
        }

        match /rules/{ruleId} {
          allow read, write: if isFamilyParent(familyId);
          allow read: if isLinkedChild(familyId, childId);
        }
      }
    }
  }
}
